/*********************************************************************
 *
 * Privoxy Windows Resource File
 *
 * Purpose     :  Embed icons and other resources into the executable
 *
 *********************************************************************/

// Icon resource IDs
#define IDI_MAINICON        200
#define IDI_ANIMATED1       201
#define IDI_ANIMATED2       202
#define IDI_ANIMATED3       203
#define IDI_ANIMATED4       204
#define IDI_ANIMATED5       205
#define IDI_ANIMATED6       206
#define IDI_ANIMATED7       207
#define IDI_ANIMATED8       208
#define IDI_IDLE            209
#define IDI_OFF             210

// Version Information
VS_VERSION_INFO VERSIONINFO
  FILEVERSION 4,1,0,0
  PRODUCTVERSION 4,1,0,0
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Privoxy Team"
            VALUE "FileDescription", "Privoxy Web Proxy"
            VALUE "FileVersion", "4.1.0"
            VALUE "InternalName", "privoxy"
            VALUE "LegalCopyright", "Copyright (C) 2001-2024 Privoxy Team"
            VALUE "OriginalFilename", "privoxy.exe"
            VALUE "ProductName", "Privoxy"
            VALUE "ProductVersion", "4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Icons
// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MAINICON        ICON    DISCARDABLE     "assets/privoxy.ico"
IDI_ANIMATED1       ICON    DISCARDABLE     "assets/radar-01.ico"
IDI_ANIMATED2       ICON    DISCARDABLE     "assets/radar-02.ico"
IDI_ANIMATED3       ICON    DISCARDABLE     "assets/radar-03.ico"
IDI_ANIMATED4       ICON    DISCARDABLE     "assets/radar-04.ico"
IDI_ANIMATED5       ICON    DISCARDABLE     "assets/radar-05.ico"
IDI_ANIMATED6       ICON    DISCARDABLE     "assets/radar-06.ico"
IDI_ANIMATED7       ICON    DISCARDABLE     "assets/radar-07.ico"
IDI_ANIMATED8       ICON    DISCARDABLE     "assets/radar-08.ico"
IDI_IDLE            ICON    DISCARDABLE     "assets/privoxy.ico"
IDI_OFF             ICON    DISCARDABLE     "assets/off.ico"
